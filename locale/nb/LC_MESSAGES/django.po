#: tall_project/navigation.py:216 tall_project/navigation.py:347
#: tall_project/templates/pages/resources.html:24
msgid "Quranian Numerology"
msgstr "Koransk numerologi"

#: tall_project/navigation.py:219
msgid "How numerical patterns are studied in Quranic tradition, and how this compares with Pythagorean numerology."
msgstr "Hvordan tallmønstre studeres i koransk tradisjon, og hvordan dette sammenlignes med pytagoreisk numerologi."

#: tall_project/navigation.py:225 tall_project/navigation.py:348
#: tall_project/templates/pages/projects-lab.html:20
msgid "Quranic Analysis"
msgstr "Koransk analyse"

#: tall_project/navigation.py:228
msgid "A closer analytical look at numerical patterns in Quranic tradition — see Quranian Numerology for the full overview."
msgstr "Et nærmere analytisk blikk på tallmønstre i koransk tradisjon — se Koransk numerologi for hele oversikten."

