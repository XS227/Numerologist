#: tall_project/navigation.py:37 tall_project/navigation.py:308
#: tall_project/templates/pages/resources.html:35
msgid "Discover Numerology"
msgstr "Oppdag numerologi"

#: tall_project/navigation.py:40
msgid "An introduction to numerology with Åse Steinsland: the Pythagorean roots of the method, how each digit is interpreted, and where to find the reference charts."
msgstr "En introduksjon til numerologi med Åse Steinsland: metodens pytagoreiske røtter, hvordan hvert siffer tolkes, og hvor du finner referansetabellene."

#: tall_project/navigation.py:46 tall_project/navigation.py:305
#: tall_project/templates/pages/calculators.html:4
#: tall_project/templates/pages/calculators.html:117
msgid "Calculator suite"
msgstr "Kalkulatorsamling"

#: tall_project/navigation.py:49
msgid "Free numerology calculators for your life path, destiny, and name numbers, with a plain-language explanation of what each result means."
msgstr "Gratis numerologikalkulatorer for livsveitall, skjebnetall og navnetall, med en enkel forklaring av hva hvert resultat betyr."

#: tall_project/navigation.py:55 tall_project/navigation.py:310
#: tall_project/templates/pages/discover-numerology.html:25
msgid "Pythagoras' Legacy"
msgstr "Pytagoras' arv"

#: tall_project/navigation.py:58
msgid "How Pythagorean number theory became the historical foundation for modern numerology, and what that lineage means for Åse's method today."
msgstr "Hvordan pytagoreisk tallteori ble det historiske fundamentet for moderne numerologi, og hva denne arven betyr for Åses metode i dag."

#: tall_project/navigation.py:64 tall_project/navigation.py:312
#: tall_project/templates/pages/discover-numerology.html:26
msgid "General Interpretation of Numbers"
msgstr "Generell tolkning av tall"

#: tall_project/navigation.py:67
msgid "A general guide to what each core number from 1-9 and the master numbers represent in numerology, before you calculate your own."
msgstr "En generell guide til hva hvert grunntall fra 1–9 og mesternumrene representerer i numerologi, før du beregner dine egne."

#: tall_project/navigation.py:73 tall_project/navigation.py:315
#: tall_project/templates/pages/discover-numerology.html:27
msgid "Calculation Methods Overview"
msgstr "Oversikt over beregningsmetoder"

#: tall_project/navigation.py:76
msgid "An overview of the calculation methods behind life path, destiny, and name numbers, so you understand the maths before trusting the result."
msgstr "En oversikt over beregningsmetodene bak livsveitall, skjebnetall og navnetall, slik at du forstår regnestykket før du stoler på resultatet."

#: tall_project/navigation.py:82 tall_project/navigation.py:317
#: tall_project/templates/pages/discover-numerology.html:28
msgid "Letter Value Chart"
msgstr "Bokstavverditabell"

#: tall_project/navigation.py:85
msgid "The Pythagorean letter-to-number chart used to calculate name, vowel, and consonant numbers, with guidance on how to apply it correctly."
msgstr "Den pytagoreiske bokstav-til-tall-tabellen som brukes til å beregne navne-, vokal- og konsonanttall, med veiledning i riktig bruk."

#: tall_project/navigation.py:91 tall_project/navigation.py:322
msgid "Personal Insights"
msgstr "Personlig innsikt"

#: tall_project/navigation.py:94
msgid "How personal numerology insights — destiny, name, and life-stage numbers — fit together into one coherent reading of your path."
msgstr "Hvordan personlig numerologisk innsikt — skjebnetall, navnetall og livsfasetall — henger sammen til én helhetlig tolkning av din vei."

#: tall_project/navigation.py:100 tall_project/navigation.py:324
#: tall_project/templates/pages/calculators.html:191
#: tall_project/templates/pages/personal-insights.html:18
msgid "Compute Your Destiny Number"
msgstr "Beregn ditt skjebnetall"

#: tall_project/navigation.py:103
msgid "How to calculate your destiny number from your birth date, and what it reveals about your long-term direction and purpose."
msgstr "Hvordan du beregner skjebnetallet ditt fra fødselsdatoen, og hva det avslører om din langsiktige retning og hensikt."

#: tall_project/navigation.py:109 tall_project/navigation.py:327
#: tall_project/templates/pages/personal-insights.html:19
msgid "Compute Name, Vowel & Consonant Numbers"
msgstr "Beregn navne-, vokal- og konsonanttall"

#: tall_project/navigation.py:112
msgid "How to calculate your name, vowel (soul urge), and consonant numbers, and what each one says about your inner motivation versus outer expression."
msgstr "Hvordan du beregner navnetall, vokaltall (sjelstall) og konsonanttall, og hva hvert av dem sier om din indre motivasjon versus ditt ytre uttrykk."

#: tall_project/navigation.py:118 tall_project/navigation.py:329
#: tall_project/templates/pages/personal-insights.html:20
msgid "Life's 4th Development Stage"
msgstr "Livets fjerde utviklingstrinn"

#: tall_project/navigation.py:121
msgid "What the fourth pinnacle stage of life represents in numerology, and how to recognise when you have entered it."
msgstr "Hva det fjerde toppunktet i livet representerer i numerologi, og hvordan du kjenner igjen når du har trådt inn i det."

#: tall_project/navigation.py:127 tall_project/navigation.py:331
#: tall_project/templates/pages/personal-insights.html:21
msgid "Realization Number — Your Ultimate Aim"
msgstr "Realiseringstall — ditt endelige mål"

#: tall_project/navigation.py:130
msgid "How to calculate your realization number, the numerology figure linked to your ultimate life aim and sense of fulfilment."
msgstr "Hvordan du beregner realiseringstallet, tallet i numerologien knyttet til ditt endelige livsmål og følelse av oppfyllelse."

#: tall_project/navigation.py:136 tall_project/navigation.py:333
#: tall_project/templates/pages/personal-insights.html:22
msgid "Pythagoras' Arrows"
msgstr "Pytagoras' piler"

#: tall_project/navigation.py:139
msgid "How Pythagoras' Arrows (the numerology grid built from your birth date) reveal patterns of strength and missing lessons in your chart."
msgstr "Hvordan Pytagoras' piler (tallrutenettet bygget fra fødselsdatoen din) avslører styrkemønstre og lærdommer som mangler i kartet ditt."

#: tall_project/navigation.py:145 tall_project/navigation.py:334
#: tall_project/templates/pages/personal-insights.html:23
msgid "Do You See the Same Number?"
msgstr "Ser du det samme tallet igjen og igjen?"

#: tall_project/navigation.py:148
msgid "What it means in numerology when you keep noticing the same repeating number, such as 11:11, 222, or 333."
msgstr "Hva det betyr i numerologi når du stadig legger merke til det samme gjentakende tallet, som 11:11, 222 eller 333."

#: tall_project/navigation.py:154 tall_project/navigation.py:339
msgid "Resources"
msgstr "Ressurser"

#: tall_project/navigation.py:157
msgid "Free analyses, projects, references, and media coverage from Åse Steinsland's numerology practice, gathered in one place."
msgstr "Gratis analyser, prosjekter, referanser og medieomtale fra Åse Steinslands numerologipraksis, samlet på ett sted."

#: tall_project/navigation.py:163 tall_project/navigation.py:342
#: tall_project/templates/pages/resources.html:18
msgid "Projects Lab"
msgstr "Prosjektlab"

#: tall_project/navigation.py:166
msgid "Experimental and research projects from the Numerologist studio, connecting numerology with data, culture, and technology."
msgstr "Eksperimentelle forskningsprosjekter fra Numerologist-studioet, som knytter numerologi sammen med data, kultur og teknologi."

#: tall_project/navigation.py:172 tall_project/navigation.py:343
#: tall_project/templates/pages/projects-lab.html:16
#: tall_project/templates/pages/resources.html:19
msgid "Arecibo Line"
msgstr "Arecibo Line"

#: tall_project/navigation.py:175
msgid "The Arecibo Line project: exploring number symbolism through the lens of the 1974 Arecibo message and its numerical structure."
msgstr "Arecibo Line-prosjektet: utforsker tallsymbolikk gjennom Arecibo-budskapet fra 1974 og dets tallstruktur."

#: tall_project/navigation.py:181 tall_project/navigation.py:341
#: tall_project/templates/pages/resources.html:20
msgid "Free Analyses"
msgstr "Gratis analyser"

#: tall_project/navigation.py:184
msgid "What you get from a free introductory numerology analysis with Åse Steinsland, and how to request one."
msgstr "Hva du får fra en gratis, innledende numerologisk analyse med Åse Steinsland, og hvordan du bestiller en."

#: tall_project/navigation.py:190 tall_project/navigation.py:344
